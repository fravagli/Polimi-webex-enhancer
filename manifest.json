{
  "name": "PoliMi Webex Enhancer",
  "version": "2.0.11",
  "manifest_version": 3,
  "description": "Ottimizzazione e funzionalità avanzate per lo studio e la visione offline delle videolezioni PoliMi su Webex e SharePoint.",
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PoliMi Webex Enhancer",
    "default_icon": {
      "16": "images/logo16.png",
      "32": "images/logo32.png",
      "48": "images/logo48.png",
      "128": "images/logo128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "unlimitedStorage",
    "webRequest",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "*://*.webex.com/*",
    "*://*.wbx2.com/*",
    "*://*.webexcontent.com/*",
    "*://polimi365.sharepoint.com/*",
    "*://*.sharepoint.com/*",
    "*://*.microsoftstream.com/*",
    "https://api.groq.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.webex.com/*",
        "*://polimi365.sharepoint.com/*",
        "*://*.sharepoint.com/*",
        "*://*.microsoftstream.com/*"
      ],
      "js": [
        "offline_db.js",
        "audio_enhancer.js",
        "ai_transcriber.js",
        "helper.js"
      ],
      "css": [
        "helper.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "offline_player.html",
        "offline_player.js",
        "offline_db.js",
        "mediabunny.min.js",
        "ai_transcriber.js",
        "audio_enhancer.js",
        "rnnoise.wasm",
        "rnnoise_worklet.js",
        "helper.css",
        "images/logo16.png",
        "images/logo32.png",
        "images/logo48.png",
        "images/logo128.png",
        "images/logo_full.png"
      ],
      "matches": [
        "*://*.webex.com/*",
        "*://*.wbx2.com/*",
        "*://*.webexcontent.com/*",
        "*://polimi365.sharepoint.com/*",
        "*://*.sharepoint.com/*",
        "*://*.microsoftstream.com/*"
      ]
    }
  ]
}
